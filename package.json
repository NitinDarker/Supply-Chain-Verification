{
  "name": "Velen",
  "version": "1.0.0",
  "author": "Nitin Sharma",
  "description": "Private Blockchain-Based Digital Wallet and Supply Chain Verification",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:infra": "docker compose up",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:infra\"",
    "install:all": "cd backend && npm install && cd ../frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.3.2",
    "lucide-react": "^1.7.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.6"
  }
}
